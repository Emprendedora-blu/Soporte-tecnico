spring.application.name=users
server.port=8082

# Persistencia MySQL (conectado a usuarios_db)
spring.datasource.url=jdbc:mysql://localhost:3306/usuarios_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Lima
spring.datasource.username=root
spring.datasource.password=CHANGE_ME

spring.jpa.show-sql=true
spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.open-in-view=false

# Clave secreta JWT (debe coincidir exactamente con soporte-tecnico-api)
jwt.secret-key=CHANGE_ME_MIN_32_CARACTERES
jwt.expiration-time=86400000

# Swagger / OpenAPI
springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.swagger-ui.enabled=true

# Copia este archivo como application.properties (sin .example) y reemplaza los valores CHANGE_ME.
# application.properties esta en .gitignore: nunca se sube al repositorio.
