  "item": [
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Crear cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Flor Torres\",\n  \"correo\": \"flortorres@idat.pe\",\n  \"telefono\": \"958324912\",\n  \"empresa\": \"Teconologia Blu\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/clientes", "host": ["{{baseUrl}}"], "path": ["api", "clientes"] }
          }
        },
        {
          "name": "Listar clientes",
          "request": {
